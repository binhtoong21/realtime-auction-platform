PORT=3000
DATABASE_URL=postgres://auction_user:auction_password@localhost:5433/auction_db
REDIS_URL=redis://localhost:6380

# JWT Secrets (use different values in production!)
JWT_ACCESS_SECRET=dev_access_secret_key
JWT_REFRESH_SECRET=dev_refresh_secret_key

# Email (leave empty for auto Ethereal in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@auction.dev

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudflare R2 / S3
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-your_public_url.r2.dev
